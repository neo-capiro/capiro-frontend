/FunnelLifetime\";\nimport { useFunnelApi, useFunnelSession } from \"../../lib/funnel\";\nimport {\n  createLegalReviewLifetime,\n  legalReviewIdentity,\n} from \"../../lib/legal-review-lifetime\";\nimport { Btn, FunnelShell } from \"../../ui/primitives\";\nimport { ErrorText } from \"./shared\";\nimport { LegalReview } from \"./LegalReview\";\n\n/** Current read admission is separate from the consent editor for that exact read. */\nexport function LegalPage() {\n  const api = useFunnelApi();\n  const cache = useQueryClient();\n  const lifetime = useFunnelLifetime();\n  const session = useFunnelSession();\n  const plan = session.data?.plan ?? null;\n  const key = useMemo(() => [...lifetime.key, \"legal\", plan], [lifetime, plan]);\n  const docs = useQuery({\n    queryKey: key,\n    queryFn: () => lifetime.read(api.getLegal),\n    enabled: plan !== null,\n    retry: false,\n    staleTime: 0,\n  });\n  // Track successful/current-read notifications even when structural sharing\n  // preserves identical document objects. Loading or failed reads end review.\n  const readUpdatedAt = docs.dataUpdatedAt;\n  const generation = cache.getQueryState(key)?.dataUpdateCount;\n  const identity =\n    session.data && docs.data\n      ? legalReviewIdentity(session.data, docs.data)\n      : null;\n  const review = useMemo(\n    () => (identity ? createLegalReviewLifetime(cache, key, identity) : null),\n    [cache, key, identity, generation, readUpdatedAt],\n  );\n  if (\n    !session.isSuccess ||\n    session.error ||\n    !session.data ||\n    !docs.isSuccess ||\n    docs.error ||\n    docs.isFetching ||\n    !identity ||\n    !review\n  )\n    return (\n      <FunnelShell step={3}>\n        <ErrorText>\n          {docs.error || session.error\n            ? \"Current legal documents are unavailable. Retry before signing.\"\n            : \"Loading current legal documents…\"}\n        </ErrorText>\n        <Btn disabled={docs.isFetching} onClick={() => void docs.refetch()}>\n          Retry current documents\n        </Btn>\n      </FunnelShell>\n    );\n  return (\n    <LegalReview\n      key={JSON.stringify([identity, generation])}\n      snapshot={session.data}\n      documents={docs.data}\n      review={review}\n    />\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/tmp/capiro-onboard-execution-20261013/apps/web/src/features/onboard/pages/funnel/LegalReview.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/tmp/capiro-onboard-execution-20261013/apps/web/src/features/onboard/pages/funnel/OrgPage.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/tmp/capiro-onboard-execution-20261013/apps/web/src/features/onboard/pages/funnel/PaidBilling.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/tmp/capiro-onboard-execution-20261013/apps/web/src/features/onboard/pages/funnel/PlanPage.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/tmp/capiro-onboard-execution-20261013/apps/web/src/features/onboard/pages/funnel/RegisterPage.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/tmp/capiro-onboard-execution-20261013/apps/web/src/features/onboard/pages/funnel/StripePayment.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/tmp/capiro-onboard-execution-20261013/apps/web/src/features/onb