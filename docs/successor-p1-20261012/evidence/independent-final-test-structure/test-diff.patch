diff --git a/apps/web/test/browser/billing-flow.spec.ts b/apps/web/test/browser/billing-flow.spec.ts
new file mode 100644
index 0000000..7d14d83
--- /dev/null
+++ b/apps/web/test/browser/billing-flow.spec.ts
@@ -0,0 +1,396 @@
+import { expect, test, type Page } from "@playwright/test";
+import { onlyLocalRequests, operationFixtures } from "./fixtures";
+import { settingsFixtures } from "./settings-fixtures";
+
+const portalUrl = "https://billing.stripe.com/p/session/synthetic-test";
+const checkoutUrl = "https://checkout.stripe.com/c/pay/synthetic-test";
+const initialSummary = settingsFixtures["settings.billing.summary"];
+
+async function billingFixture(
+  page: Page,
+  overrides: Partial<typeof initialSummary> = {},
+) {
+  await onlyLocalRequests(page);
+  const current = { summary: { ...initialSummary, ...overrides } };
+  const writes: { operation: string; input: unknown }[] = [];
+  await operationFixtures(page, {
+    ...settingsFixtures,
+    "settings.billing.summary": () => current.summary,
+    "settings.billing.state": {
+      ...settingsFixtures["settings.billing.state"],
+      status: current.summary.status,
+      billingEnabled: current.summary.billingEnabled,
+    },
+    "settings.billing.portal": (input) => {
+      writes.push({ operation: "portal", input });
+      return { url: portalUrl };
+    },
+    "settings.billing.checkout": (input) => {
+      writes.push({ operation: "checkout", input });
+      return { url: checkoutUrl };
+    },
+  });
+  // Hosted destinations are synthetic documents, never provider requests.
+  for (const url of [portalUrl, checkoutUrl])
+    await page.route(url, (route) =>
+      route.fulfill({
+        contentType: "text/html",
+        body: "Synthetic hosted flow",
+      }),
+    );
+  await page.goto("/settings/billing");
+  await expect(page.getByRole("heading", { name: "Your plan" })).toBeVisible();
+  return { current, writes };
+}
+
+for (const status of [
+  "active",
+  "past_due",
+  "trialing",
+  "canceled",
+  "none",
+  "comped",
+]) {
+  test(`${status} subscriber adds profiles through the portal, never checkout`, async ({
+    page,
+  }, testInfo) => {
+    const { writes } = await billingFixture(page, { status });
+    if (status === "active")
+      await page.screenshot({
+        path: testInfo.outputPath("billing-existing-subscription.png"),
+        fullPage: true,
+      });
+    await page
+      .getByRole("button", { name: "Add profiles", exact: true })
+      .click();
+    await expect(page.getByRole("dialog")).toHaveCount(0);
+    await expect(page).toHaveURL(portalUrl);
+    expect(writes).toEqual([{ operation: "portal", input: {} }]);
+  });
+}
+
+for (const status of ["none", "trialing"]) {
+  test(`${status} non-subscriber can review a new subscription`, async ({
+    page,
+  }) => {
+    const { writes } = await billingFixture(page, {
+      status,
+      hasSubscription: false,
+    });
+    await page
+      .getByRole("button", { name: "Start subscription", exact: true })
+      .click();
+    const dialog = page.getByRole("dialog", { name: "Start subscription" });
+    await dialog.getByLabel("Total profiles", { exact: true }).fill("15");
+    await dialog
+      .getByLabel("Access or promotion code (optional)")
+      .fill("SYNTHETIC");
+    await dialog.getByRole("button", { name: "Review checkout" }).click();
+    await expect(page).toHaveURL(checkoutUrl);
+    expect(writes).toEqual([
+      {
+        operation: "checkout",
+        input: { body: { quantity: 15, promoCode: "SYNTHETIC" } },
+      },
+    ]);
+  });
+}
+
+for (const status of ["active", "past_due", "canceled", "comped"]) {
+  test(`${status} without a subscription does not infer checkout eligibility`, async ({
+    page,
+  }) => {
+    const { writes } = await billingFixture(page, {
+      status,
+      hasSubscription: false,
+    });
+    await expect(
+      page.getByRole("button", { name: "Add profiles", exact: true }),
+    ).toBeDisabled();
+    await expect(
+      page.getByText("Profile changes are unavailable for this billing state."),
+    ).toBeVisible();
+    await expect(
+      page.getByRole("button", { name: "Start subscription" }),
+    ).toHaveCount(0);
+    expect(writes).toEqual([]);
+  });
+}
+
+test("disabled billing cannot open either hosted flow", async ({ page }) => {
+  const { writes } = await billingFixture(page, { billingEnabled: false });
+  await expect(
+    page.getByRole("button", { name: "Add profiles", exact: true }),
+  ).toBeDisabled();
+  await expect(
+    page.getByRole("button", { name: "Update", exact: true }),
+  ).toBeDisabled();
+  expect(writes).toEqual([]);
+});
+
+test("checkout closes when a fresh summary reports an existing subscription", async ({
+  page,
+}) => {
+  const { current, writes } = await billingFixture(page, {
+    status: "none",
+    hasSubscription: false,
+  });
+  await page
+    .getByRole("button", { name: "Start subscription", exact: true })
+    .click();
+  const dialog = page.getByRole("dialog", { name: "Start subscription" });
+  await dialog.getByLabel("Total profiles", { exact: true }).fill("17");
+  current.summary = {
+    ...current.summary,
+    status: "active",
+    hasSubscription: true,
+  };
+  await dialog.getByRole("button", { name: "Review checkout" }).click();
+  await expect(dialog).toHaveCount(0);
+  await expect(page.getByRole("alert")).toContainText(
+    "Refresh billing before continuing",
+  );
+  expect(writes).toEqual([]);
+});
+
+for (const read of ["summary", "state"]) {
+  test(`failed current ${read} prevents checkout from a previously opened form`, async ({
+    page,
+  }) => {
+    const { writes } = await billingFixture(page, {
+      status: "none",
+      hasSubscription: false,
+    });
+    await page
+      .getByRole("button", { name: "Start subscription", exact: true })
+      .click();
+    await page.route(`**/api/capiro/settings.billing.${read}?*`, (route) =>
+      route.fulfill({
+        status: 503,
+        json: { message: `Synthetic ${read} unavailable` },
+      }),
+    );
+    const dialog = page.getByRole("dialog", { name: "Start subscription" });
+    await dialog.getByRole("button", { name: "Review checkout" }).click();
+    await expect(dialog.getByRole("alert")).toContainText(
+      `Synthetic ${read} unavailable`,
+    );
+    expect(writes).toEqual([]);
+  });
+}
+
+test("an existing-subscriber action rechecks that a subscription still exists", async ({
+  page,
+}) => {
+  const { current, writes } = await billingFixture(page);
+  current.summary = {
+    ...current.summary,
+    status: "none",
+    hasSubscription: false,
+  };
+  await page.getByRole("button", { name: "Add profiles", exact: true }).click();
+  await expect(page.getByRole("alert")).toContainText(
+    "Refresh billing before continuing",
+  );
+  expect(writes).toEqual([]);
+});
+
+for (const flow of ["portal", "checkout"] as const) {
+  test(`${flow} rejects a receipt for the other hosted flow`, async ({
+    page,
+  }) => {
+    await billingFixture(
+      page,
+      flow === "checkout" ? { status: "none", hasSubscription: false } : {},
+    );
+    await page.route(`**/api/capiro/settings.billing.${flow}`, (route) =>
+      route.fulfill({
+        json: { url: flow === "portal" ? checkoutUrl : portalUrl },
+      }),
+    );
+    if (flow === "checkout") {
+      await page
+        .getByRole("button", { name: "Start subscription", exact: true })
+        .click();
+      await page.getByRole("button", { name: "Review checkout" }).click();
+    } else
+      await page
+        .getByRole("button", { name: "Add profiles", exact: true })
+        .click();
+    await expect(page.getByRole("alert").last()).toContainText(
+      "unexpected billing destination",
+    );
+    await expect(page).toHaveURL(/\/settings\/billing$/);
+  });
+}
+
+for (const flow of ["portal", "checkout"] as const) {
+  test(`repeated clicks while summary revalidation is pending dispatch one ${flow} request`, async ({
+    page,
+  }) => {
+    const { current, writes } = await billingFixture(
+      page,
+      flow === "checkout" ? { status: "none", hasSubscription: false } : {},
+    );
+    if (flow === "checkout")
+      await page
+        .getByRole("button", { name: "Start subscription", exact: true })
+        .click();
+    let release!: () => void;
+    const waiting = new Promise<void>((resolve) => {
+      release = resolve;
+    });
+    let reads = 0;
+    await page.route(
+      "**/api/capiro/settings.billing.summary?*",
+      async (route) => {
+        reads++;
+        await waiting;
+        await route.fulfill({ json: current.summary });
+      },
+    );
+    const button = page.getByRole("button", {
+      name: flow === "portal" ? "Add profiles" : "Review checkout",
+      exact: true,
+    });
+    await button.evaluate((element: HTMLButtonElement) => {
+      element.click();
+      element.click();
+    });
+    await expect(button).toBeDisabled();
+    await expect.poll(() => reads).toBe(1);
+    expect(writes).toEqual([]);
+    release();
+    await expect(page).toHaveURL(flow === "portal" ? portalUrl : checkoutUrl);
+    expect(writes).toEqual([
+      {
+        operation: flow,
+        input: flow === "portal" ? {} : { body: { quantity: 10 } },
+      },
+    ]);
+  });
+}
+
+test("session replacement discards a pending hosted receipt", async ({
+  page,
+}) => {
+  await billingFixture(page);
+  let release!: () => void;
+  const waiting = new Promise<void>((resolve) => {
+    release = resolve;
+  });
+  let dispatched = 0;
+  let offered = false;
+  await page.route("**/api/capiro/settings.billing.portal", async (route) => {
+    dispatched++;
+    await waiting;
+    await route.fulfill({ json: { url: portalUrl } });
+    offered = true;
+  });
+  await page.getByRole("button", { name: "Add profiles", exact: true }).click();
+  await expect.poll(() => dispatched).toBe(1);
+  await page.evaluate(() =>
+    window.dispatchEvent(
+      new CustomEvent("test:session", {
+        detail: { sessionId: "replacement-session" },
+      }),
+    ),
+  );
+  await expect(
+    page.getByRole("button", { name: "Add profiles", exact: true }),
+  ).toBeEnabled();
+  release();
+  await expect.poll(() => offered).toBe(true);
+  await page.evaluate(
+    () =>
+      new Promise<void>((resolve) =>
+        requestAnimationFrame(() => requestAnimationFrame(() => resolve())),
+      ),
+  );
+  await expect(page.getByRole("heading", { name: "Your plan" })).toBeVisible();
+  await expect(page).toHaveURL(/\/settings\/billing$/);
+  await expect(page.getByText("Opening billing portal…")).toHaveCount(0);
+});
+
+test("contradictory current reads and failed initial summary expose no billing action", async ({
+  page,
+}) => {
+  const { writes } = await billingFixture(page, {
+    status: "none",
+    hasSubscription: false,
+  });
+  await page.route("**/api/capiro/settings.billing.state?*", (route) =>
+    route.fulfill({
+      json: { ...settingsFixtures["settings.billing.state"], status: "active" },
+    }),
+  );
+  await page.reload();
+  await expect(
+    page.getByRole("button", { name: "Add profiles", exact: true }),
+  ).toBeDisabled();
+  await page.route("**/api/capiro/settings.billing.summary?*", (route) =>
+    route.fulfill({
+      status: 503,
+      json: { message: "Synthetic billing read failed" },
+    }),
+  );
+  await page.reload();
+  await expect(page.getByText("Synthetic billing read failed")).toBeVisible();
+  await expect(
+    page.getByRole("button", {
+      name: /Add profiles|Start subscription|Review checkout/,
+    }),
+  ).toHaveCount(0);
+  expect(writes).toEqual([]);
+});
+
+test("session replacement during revalidation prevents dispatch from the old form", async ({
+  page,
+}) => {
+  const { current, writes } = await billingFixture(page, {
+    status: "none",
+    hasSubscription: false,
+  });
+  let release!: () => void;
+  const waiting = new Promise<void>((resolve) => {
+    release = resolve;
+  });
+  let held = false;
+  let offered = false;
+  await page.route(
+    "**/api/capiro/settings.billing.summary?*",
+    async (route) => {
+      if (!held) {
+        held = true;
+        await waiting;
+        await route.fulfill({ json: current.summary });
+        offered = true;
+      } else await route.fulfill({ json: current.summary });
+    },
+  );
+  await page
+    .getByRole("button", { name: "Start subscription", exact: true })
+    .click();
+  await page.getByRole("button", { name: "Review checkout" }).click();
+  await expect.poll(() => held).toBe(true);
+  await page.evaluate(() =>
+    window.dispatchEvent(
+      new CustomEvent("test:session", {
+        detail: { sessionId: "another-session" },
+      }),
+    ),
+  );
+  await expect(
+    page.getByRole("button", { name: "Start subscription", exact: true }),
+  ).toBeEnabled();
+  release();
+  await expect.poll(() => offered).toBe(true);
+  await page.evaluate(
+    () =>
+      new Promise<void>((resolve) =>
+        requestAnimationFrame(() => requestAnimationFrame(() => resolve())),
+      ),
+  );
+  expect(writes).toEqual([]);
+  await expect(page.getByRole("dialog")).toHaveCount(0);
+});
diff --git a/apps/web/test/browser/prospect-draft-pending-edit.spec.ts b/apps/web/test/browser/prospect-draft-pending-edit.spec.ts
new file mode 100644
index 0000000..5275cb5
--- /dev/null
+++ b/apps/web/test/browser/prospect-draft-pending-edit.spec.ts
@@ -0,0 +1,279 @@
+import { test, expect, type Page } from "@playwright/test";
+import { onlyLocalRequests, operationFixtures, testIdentity } from "./fixtures";
+import { moduleRouteFixtures } from "./module-route-fixtures";
+import {
+  draft,
+  prospectId,
+  otherId,
+} from "../../tests/prospect-resources-fixtures";
+
+const detail = `/modules/workspace?prospectId=${prospectId}&draftId=${draft.id}`;
+const submitted = {
+  title: "Submitted prospect title",
+  body: "Submitted prospect body",
+  summary: "Submitted prospect summary",
+};
+const version = {
+  id: otherId,
+  draftId: draft.id,
+  label: "Manual save",
+  authorId: "test-user",
+  authorKind: "human",
+  createdAt: "2026-10-12T12:01:00Z",
+};
+type Phase = "update" | "snapshot";
+type Outcome = "success" | "failure" | "lost receipt";
+
+async function heldSave(
+  page: Page,
+  phase: Phase,
+  outcome: Outcome = "success",
+) {
+  await onlyLocalRequests(page);
+  let current = {
+    ...structuredClone(draft),
+    config: {
+      sections: ["Body", "Summary"],
+      sectionContent: { Body: "", Summary: "" },
+    },
+  };
+  await operationFixtures(page, {
+    ...moduleRouteFixtures,
+    "workspace.prospect.drafts": { drafts: [] },
+    "workspace.draft": current,
+    "workspace.draft.versions": [version],
+  });
+  const writes: string[] = [];
+  let entered = false;
+  let release!: () => void;
+  const held = new Promise<void>((resolve) => {
+    release = resolve;
+  });
+  await page.route("**/api/capiro/workspace.draft?*", (route) =>
+    route.fulfill({ json: current }),
+  );
+  for (const operation of ["update", "snapshot"] as const)
+    await page.route(
+      `**/api/capiro/workspace.draft.${operation}`,
+      async (route) => {
+        writes.push(operation);
+        if (operation === phase && !entered) {
+          entered = true;
+          await held;
+          if (outcome === "failure")
+            return route.fulfill({
+              status: 500,
+              json: { message: "Save failed" },
+            });
+          if (outcome === "lost receipt") return route.abort("connectionreset");
+        }
+        if (operation === "update") {
+          const { body } = route.request().postDataJSON();
+          current = {
+            ...current,
+            docTitle: body.docTitle,
+            config: body.config,
+            updatedAt: "2026-10-12T12:01:00Z",
+          };
+        }
+        await route.fulfill({
+          json: operation === "update" ? current : version,
+        });
+      },
+    );
+  return { writes, release, started: () => entered };
+}
+
+function fields(page: Page) {
+  return [
+    page.getByLabel("Document title", { exact: true }),
+    page.getByLabel("Body content"),
+    page.getByLabel("Summary content"),
+  ] as const;
+}
+async function beginSave(page: Page) {
+  await page.goto(detail);
+  const [title, body, summary] = fields(page);
+  await title.fill(submitted.title);
+  await body.fill(submitted.body);
+  await summary.fill(submitted.summary);
+  await page.getByRole("button", { name: "Save draft", exact: true }).click();
+}
+async function expectSubmitted(page: Page) {
+  const [title, body, summary] = fields(page);
+  await expect(title).toHaveValue(submitted.title);
+  await expect(body).toHaveValue(submitted.body);
+  await expect(summary).toHaveValue(submitted.summary);
+}
+
+for (const phase of ["update", "snapshot"] as const) {
+  for (const outcome of ["success", "failure", "lost receipt"] as const) {
+    test(`prospect fields freeze during held ${phase}; ${outcome} preserves submitted text`, async ({
+      page,
+    }) => {
+      const control = await heldSave(page, phase, outcome);
+      await beginSave(page);
+      await expect.poll(control.started).toBe(true);
+      for (const field of fields(page)) await expect(field).toBeDisabled();
+      await expectSubmitted(page);
+      control.release();
+      const save = page.getByRole("button", {
+        name: "Save draft",
+        exact: true,
+      });
+      if (outcome === "success") {
+        await expect(save).toBeEnabled();
+        await expectSubmitted(page);
+        expect(control.writes).toEqual(["update", "snapshot"]);
+        await page.reload();
+        await expectSubmitted(page);
+        await expect(
+          page.getByText(/previous save is not confirmed/),
+        ).toHaveCount(0);
+      } else {
+        await expect(
+          page.getByText(/previous save is not confirmed/),
+        ).toBeVisible();
+        await expect(save).toBeDisabled();
+        const originalWrites =
+          phase === "update" ? ["update"] : ["update", "snapshot"];
+        expect(control.writes).toEqual(originalWrites);
+        await page.reload();
+        await expectSubmitted(page);
+        await expect(save).toBeDisabled();
+        await page
+          .getByRole("button", { name: "Read current document" })
+          .click();
+        await expect(save).toBeEnabled();
+        await expectSubmitted(page);
+        expect(control.writes).toEqual(originalWrites);
+        await save.click();
+        await expect(save).toBeEnabled();
+        expect(control.writes).toEqual([
+          ...originalWrites,
+          "update",
+          "snapshot",
+        ]);
+      }
+      for (const field of fields(page)) await expect(field).toBeEditable();
+      await page.getByLabel("Body content").fill("Next deliberate edit");
+      await expect(page.getByLabel("Body content")).toHaveValue(
+        "Next deliberate edit",
+      );
+    });
+  }
+
+  test(`leaving during held ${phase} retains the original intent without continuing the old save`, async ({
+    page,
+  }) => {
+    const control = await heldSave(page, phase);
+    await beginSave(page);
+    await expect.poll(control.started).toBe(true);
+    for (const field of fields(page)) await expect(field).toBeDisabled();
+    await page
+      .getByRole("button", { name: "← Workspace", exact: true })
+      .click();
+    await expect(
+      page.getByRole("heading", { name: "Prospect Workspace", exact: true }),
+    ).toBeVisible();
+    control.release();
+    await page.goBack();
+    await expectSubmitted(page);
+    await expect(
+      page.getByText(/previous save is not confirmed/),
+    ).toBeVisible();
+    await page.getByRole("button", { name: "Read current document" }).click();
+    await expect(
+      page.getByRole("button", { name: "Save draft", exact: true }),
+    ).toBeEnabled();
+    expect(control.writes).toEqual(
+      phase === "update" ? ["update"] : ["update", "snapshot"],
+    );
+  });
+}
+
+for (const replacement of ["user", "tenant", "prospect", "client"] as const)
+  test(`a ${replacement} replacement during PATCH cannot restore or finish the former editor`, async ({
+    page,
+  }) => {
+    const control = await heldSave(page, "update");
+    await beginSave(page);
+    await expect.poll(control.started).toBe(true);
+    for (const field of fields(page)) await expect(field).toBeDisabled();
+    if (replacement === "client") {
+      await page.route(`**/api/backend/core/clients/${otherId}`, (route) =>
+        route.fulfill({
+          status: 403,
+          json: { error: "Replacement client denied" },
+        }),
+      );
+      await page.evaluate((path) => {
+        history.pushState({}, "", path);
+        dispatchEvent(new PopStateEvent("popstate"));
+      }, `${detail}&clientId=${otherId}`);
+      await expect(
+        page.getByRole("heading", { name: "Selected client unavailable" }),
+      ).toBeVisible();
+    } else if (replacement === "prospect") {
+      await page.evaluate(
+        (path) => {
+          history.pushState({}, "", path);
+          dispatchEvent(new PopStateEvent("popstate"));
+        },
+        detail.replace(prospectId, otherId),
+      );
+      await expect(page.getByRole("main").getByRole("alert")).toContainText(
+        "does not match",
+      );
+    } else {
+      await page.route("**/api/capiro/me.read?*", (route) =>
+        route.fulfill({
+          json: {
+            ...testIdentity,
+            ...(replacement === "user"
+              ? {
+                  user: {
+                    ...testIdentity.user,
+                    id: otherId,
+                    clerkUserId: "replacement-user",
+                  },
+                }
+              : { tenant: { ...testIdentity.tenant, id: otherId } }),
+          },
+        }),
+      );
+      await page.route("**/api/capiro/workspace.draft?*", (route) =>
+        route.fulfill({
+          status: 403,
+          json: { message: "Replacement cannot read former draft" },
+        }),
+      );
+      await page.evaluate(
+        (kind) =>
+          window.dispatchEvent(
+            new CustomEvent("test:session", {
+              detail:
+                kind === "user"
+                  ? {
+                      userId: "replacement-user",
+                      sessionId: "replacement-session",
+                    }
+                  : {
+                      orgId: "replacement-org",
+                      sessionId: "replacement-session",
+                    },
+            }),
+          ),
+        replacement,
+      );
+      await expect(page.getByRole("main").getByRole("alert")).toContainText(
+        "Replacement cannot read former draft",
+      );
+    }
+    control.release();
+    await expect(page.getByLabel("Body content")).toHaveCount(0);
+    await expect(page.getByText(submitted.body, { exact: true })).toHaveCount(
+      0,
+    );
+    expect(control.writes).toEqual(["update"]);
+  });
