+  id: "meeting",
+  subject: "Synthetic",
+  description: null,
+  location: null,
+  startsAt: "2026-10-10T14:00:00Z",
+  endsAt: "2026-10-10T15:00:00Z",
+  status: "scheduled",
+  joinLink: null,
+  visibility: "shared" as const,
+  isVirtual: false,
+  meri: null,
+  client: { id: "client", name: "Synthetic" },
+  attendees: [],
+  preps: [],
+};
+const metadata = {
+  id: "artifact",
+  meetingId: meeting.id,
+  clientId: meeting.client.id,
+  authorUserId: actor.userId,
+  confidential: false,
+  sharedAt: null,
+  sharedByUserId: null,
+  createdAt: "2026-10-10T15:00:00Z",
+  updatedAt: "2026-10-10T15:00:00Z",
+};
+const save = {
+  action: "save" as const,
+  body: "Synthetic content",
+  confidential: false,
+};
+const clearedApproval = { approvedAt: null, approvedByUserId: null };
+describe("pinned native artifact lifecycle", () => {
+  for (const kind of ["notes", "debriefs"] as ArtifactKind[]) {
+    const receipt = {
+      ...metadata,
+      status: kind === "notes" ? "draft" : "generated",
+      ...(kind === "notes" ? clearedApproval : {}),
+    };
+    it(`${kind} accepts its real creation status and rejects the other artifact's status`, () => {
+      const schema = artifactReceiptSchema(meeting, kind, actor, save);
+      expect(schema.safeParse(receipt).success).toBe(true);
+      expect(
+        schema.safeParse({
+          ...receipt,
+          status: kind === "notes" ? "generated" : "draft",
+        }).success,
+      ).toBe(false);
+    });
+    it(`${kind} accepts a native idempotent share whose original sharer was deleted`, () => {
+      const artifact = {
+        ...receipt,
+        status: "approved",
+        sharedAt: metadata.updatedAt,
+        sharedByUserId: null,
+      };
+      const schema = artifactReceiptSchema(meeting, kind, actor, {
+        action: "share",
+        id: metadata.id,
+      });
+      expect(schema.safeParse({ ...meeting, [kind]: [artifact] }).success).toBe(
+        true,
+      );
+      for (const invalid of [
+        { id: "foreign" },
+        { meetingId: "foreign" },
+        { clientId: "foreign" },
+        { status: "edited" },
+        { confidential: true },
+        { sharedAt: null },
+      ])
+        expect(
+          schema.safeParse({
+            ...meeting,
+            [kind]: [{ ...artifact, ...invalid }],
+          }).success,
+        ).toBe(false);
+      expect(
+        schema.safeParse({
+          ...meeting,
+          visibility: "private",
+          [kind]: [artifact],
+        }).success,
+      ).toBe(false);
+    });
+  }
+  for (const editing of [false, true])
+    it(`note ${editing ? "edit" : "create"} requires cleared native approval stamps`, () => {
+      const schema = artifactReceiptSchema(meeting, "notes", actor, {
+        ...save,
+        ...(editing ? { id: metadata.id } : {}),
+      });
+      const receipt = {
+        ...metadata,
+        status: editing ? "edited" : "draft",
+        ...clearedApproval,
+      };
+      expect(schema.safeParse(receipt).success).toBe(true);
+      expect(
+        schema.safeParse({ ...receipt, approvedAt: metadata.updatedAt })
+          .success,
+      ).toBe(false);
+      expect(
+        schema.safeParse({ ...receipt, approvedByUserId: actor.userId })
+          .success,
+      ).toBe(false);
+      const { approvedAt, approvedByUserId, ...incomplete } = receipt;
+      void approvedAt;
+      void approvedByUserId;
+      expect(schema.safeParse(incomplete).success).toBe(false);
+    });
+  it("debrief edit accepts edited metadata without nonexistent approval stamps", () => {
+    expect(
+      artifactReceiptSchema(meeting, "debriefs", actor, {
+        ...save,
+        id: metadata.id,
+      }).safeParse({ ...metadata, status: "edited" }).success,
+    ).toBe(true);
+  });
+});
diff --git a/apps/web/tests/files-metadata-actions.test.ts b/apps/web/tests/files-metadata-actions.test.ts
new file mode 100644
index 0000000..3e13da9
--- /dev/null
+++ b/apps/web/tests/files-metadata-actions.test.ts
@@ -0,0 +1,184 @@
+import { QueryClient } from "@tanstack/react-query";
+import { describe, expect, it, vi } from "vitest";
+import { ApiError, createApiClient } from "../src/shared/portfolio/api/http";
+import { assertClientWriter } from "../src/shared/portfolio/auth/client-writer";
+import {
+  assertFileReader,
+  currentFileReader,
+  currentFilesKey,
+} from "../src/features/portfolio/files/file-reader";
+import {
+  reviewFileMetadata,
+  saveFileMetadata,
+} from "../src/features/portfolio/files/metadata-actions";
+import { fileMetadataAttemptKey } from "../src/features/portfolio/files/metadata-attempt";
+import { clientId, file } from "./browser/fixtures";
+
+const restricted = {
+  kind: "access",
+  viewerMode: "restricted",
+  viewerUserIds: [],
+} as const;
+const change = () => ({ ...restricted, viewerUserIds: [] });
+const receipt = { ...file, viewerMode: "restricted" };
+function setup(
+  respond: (options?: RequestInit) => Response | Promise<Response>,
+) {
+  const cache = new QueryClient({
+    defaultOptions: { queries: { retry: false } },
+  });
+  cache.setQueryData(["identity"], {
+    user: { id: "user-test", email: "synthetic@example.test" },
+    tenant: { id: "tenant-test", name: "Synthetic tenant" },
+    role: "standard_user",
+  });
+  cache.setQueryData(currentFilesKey(cache, clientId), [file]);
+  const actor = currentFileReader(cache)!;
+  const controller = new AbortController();
+  const execution = {
+    actor,
+    signal: controller.signal,
+    guard() {
+      controller.signal.throwIfAborted();
+      assertFileReader(cache, actor);
+      assertClientWriter(cache, actor);
+    },
+  };
+  const fetcher = vi.fn((_url: RequestInfo | URL, options?: RequestInit) =>
+    Promise.resolve(respond(options)),
+  );
+  const api = createApiClient(fetcher);
+  const key = fileMetadataAttemptKey(clientId, file.id, actor);
+  return {
+    cache,
+    execution,
+    controller,
+    fetcher,
+    api,
+    key,
+    save: () =>
+      saveFileMetadata(api, cache, clientId, file.id, change(), execution),
+    review: () => reviewFileMetadata(api, cache, clientId, file.id, execution),
+  };
+}
+const json = (value: unknown, status = 200) =>
+  new Response(JSON.stringify(value), { status });
+
+describe("single-file metadata write lifetime and review", () => {
+  it("freezes a contradictory receipt; only explicit current GET review permits a deliberate new save", async () => {
+    let current = file;
+    let confirmed = false;
+    const state = setup((options) =>
+      json(options?.method === "PATCH" && confirmed ? receipt : current),
+    );
+    await expect(state.save()).rejects.toMatchObject({ status: 502 });
+    expect(state.cache.getQueryData(state.key)).toMatchObject({
+      status: "unknown",
+      change: change(),
+    });
+    await expect(state.save()).rejects.toMatchObject({ status: 409 });
+    expect(state.fetcher).toHaveBeenCalledTimes(1);
+    current = { ...file, id: "00000000-0000-4000-8000-000000000099" };
+    await expect(state.review()).rejects.toMatchObject({ status: 502 });
+    expect(state.cache.getQueryData(state.key)).toMatchObject({
+      status: "unknown",
+    });
+    current = file;
+    await expect(state.review()).resolves.toMatchObject({ viewerMode: "all" });
+    expect(state.cache.getQueryData(state.key)).toBeNull();
+    confirmed = true;
+    await expect(state.save()).resolves.toMatchObject({
+      viewerMode: "restricted",
+    });
+    expect(
+      state.fetcher.mock.calls.map(([, options]) => options?.method ?? "GET"),
+    ).toEqual(["PATCH", "GET", "GET", "PATCH"]);
+  });
+  it("permits correction after an explicit native rejection", async () => {
+    let reject = true;
+    const state = setup(() =>
+      reject ? json({ message: "Invalid member" }, 422) : json(receipt),
+    );
+    await expect(state.save()).rejects.toMatchObject({ status: 422 });
+    expect(state.cache.getQueryData(state.key)).toBeNull();
+    reject = false;
+    await expect(state.save()).resolves.toMatchObject({
+      viewerMode: "restricted",
+    });
+    expect(state.fetcher).toHaveBeenCalledTimes(2);
+  });
+  it("blocks double dispatch while the first PATCH is pending", async () => {
+    let release!: (response: Response) => void;
+    const state = setup(
+      () =>
+        new Promise((resolve) => {
+          release = resolve;
+        }),
+    );
+    const first = state.save();
+    await expect(state.save()).rejects.toMatchObject({ status: 409 });
+    await expect(state.review()).rejects.toMatchObject({ status: 409 });
+    expect(state.fetcher).toHaveBeenCalledTimes(1);
+    release(json(receipt));
+    await first;
+  });
+  it.each(["actor", "abort"])(
+    "does not accept a late matching PATCH after %s replacement",
+    async (boundary) => {
+      let release!: (response: Response) => void;
+      const state = setup(
+        () =>
+          new Promise((resolve) => {
+            release = resolve;
+          }),
+      );
+      const first = state.save();
+      if (boundary === "abort") state.controller.abort();
+      else
+        state.cache.setQueryData(["identity"], {
+          user: { id: "another-user", email: "synthetic@example.test" },
+          tenant: { id: "tenant-test", name: "Synthetic tenant" },
+          role: "standard_user",
+        });
+      release(json(receipt));
+      await expect(first).rejects.toBeInstanceOf(Error);
+      expect(state.cache.getQueryData(state.key)).toMatchObject({
+        status: "unknown",
+        change: change(),
+      });
+      expect(
+        state.cache.getQueryData(
+          fileMetadataAttemptKey(clientId, file.id, {
+            userId: "another-user",
+            tenantId: "tenant-test",
+          }),
+        ),
+      ).toBeUndefined();
+    },
+  );
+  it("does not release uncertainty from a GET completing after the view is replaced", async () => {
+    let release!: (response: Response) => void;
+    const state = setup((options) =>
+      options?.method === "PATCH"
+        ? json(file)
+        : new Promise((resolve) => {
+            release = resolve;
+          }),
+    );
+    await expect(state.save()).rejects.toBeInstanceOf(ApiError);
+    const review = state.review();
+    state.controller.abort();
+    release(json(receipt));
+    await expect(review).rejects.toBeInstanceOf(Error);
+    expect(state.cache.getQueryData(state.key)).toMatchObject({
+      status: "unknown",
+    });
+  });
+  it("does not dispatch a file missing from the current client collection", async () => {
+    const state = setup(() => json(receipt));
+    state.cache.setQueryData(currentFilesKey(state.cache, clientId), []);
+    await expect(state.save()).rejects.toMatchObject({ status: 409 });
+    expect(state.fetcher).not.toHaveBeenCalled();
+    expect(state.cache.getQueryData(state.key)).toBeUndefined();
+  });
+});
diff --git a/apps/web/tests/files-metadata-receipts.test.ts b/apps/web/tests/files-metadata-receipts.test.ts
new file mode 100644
index 0000000..3d504e8
--- /dev/null
+++ b/apps/web/tests/files-metadata-receipts.test.ts
@@ -0,0 +1,80 @@
+import { describe, expect, it } from "vitest";
+import { fileChangeForIdSchema } from "../src/features/portfolio/files/contracts";
+import { file } from "./browser/fixtures";
+
+describe("reviewed single-file metadata receipts", () => {
+  it("rejects a same-file receipt that did not restrict access", () => {
+    const schema = fileChangeForIdSchema(file.id, {
+      kind: "access",
+      viewerMode: "restricted",
+      viewerUserIds: [],
+    });
+    expect(schema.safeParse(file).success).toBe(false);
+  });
+  it("requires the exact restricted viewer set, rejecting missing and extra viewers", () => {
+    const schema = fileChangeForIdSchema(file.id, {
+      kind: "access",
+      viewerMode: "restricted",
+      viewerUserIds: ["viewer-a", "viewer-b"],
+    });
+    for (const ids of [["viewer-a"], ["viewer-a", "viewer-b", "viewer-c"]])
+      expect(
+        schema.safeParse({
+          ...file,
+          viewerMode: "restricted",
+          viewerUserIds: ids,
+        }).success,
+      ).toBe(false);
+  });
+  it("compares normalized viewer sets independently of order", () => {
+    const schema = fileChangeForIdSchema(file.id, {
+      kind: "access",
+      viewerMode: "restricted",
+      viewerUserIds: [" viewer-b ", "viewer-a", "viewer-a", " "],
+    });
+    expect(
+      schema.safeParse({
+        ...file,
+        viewerMode: "restricted",
+        viewerUserIds: ["viewer-a", "viewer-b"],
+      }).success,
+    ).toBe(true);
+  });
+  it("compares all-mode semantically while still requiring its returned mode", () => {
+    const schema = fileChangeForIdSchema(file.id, {
+      kind: "access",
+      viewerMode: "all",
+      viewerUserIds: ["prior-viewer"],
+    });
+    expect(schema.safeParse(file).success).toBe(true);
+    expect(
+      schema.safeParse({ ...file, viewerMode: "restricted", viewerUserIds: [] })
+        .success,
+    ).toBe(false);
+  });
+  it("rejects an unchanged folder and accepts native normalized folder or unfiled", () => {
+    const schema = fileChangeForIdSchema(file.id, {
+      kind: "move",
+      folder: "  Reviewed destination  ",
+    });
+    expect(schema.safeParse(file).success).toBe(false);
+    expect(
+      schema.safeParse({ ...file, folder: "Reviewed destination" }).success,
+    ).toBe(true);
+    expect(
+      fileChangeForIdSchema(file.id, { kind: "move", folder: " " }).safeParse({
+        ...file,
+        folder: null,
+      }).success,
+    ).toBe(true);
+  });
+  it("keeps receipt identity binding even when the effect matches", () => {
+    expect(
+      fileChangeForIdSchema(file.id, {
+        kind: "move",
+        folder: "Reports",
+      }).safeParse({ ...file, id: "60000000-0000-4000-8000-000000000009" })
+        .success,
+    ).toBe(false);
+  });
+});
