diff --git a/apps/web/src/features/portfolio/files/metadata-actions.ts b/apps/web/src/features/portfolio/files/metadata-actions.ts
new file mode 100644
index 0000000..1ad5d18
--- /dev/null
+++ b/apps/web/src/features/portfolio/files/metadata-actions.ts
@@ -0,0 +1,110 @@
+import type { QueryClient } from "@tanstack/react-query";
+import { ApiError, type ApiClient } from "@/shared/portfolio/api/http";
+import { ambiguousClientWrite } from "@/shared/portfolio/auth/client-writer";
+import {
+  fileAccessForIdSchema,
+  fileChangeForIdSchema,
+  type Attachment,
+  type FileMetadataChange,
+} from "./contracts";
+import { currentFilesKey } from "./file-reader";
+import type { FileExecution } from "./file-scope";
+import {
+  fileMetadataAttemptKey,
+  nextFileMetadataAttempt,
+  setFileMetadataAttempt,
+  settleFileMetadataAttempt,
+  type FileMetadataAttempt,
+} from "./metadata-attempt";
+
+function currentFile(
+  cache: QueryClient,
+  clientId: string,
+  id: string,
+  execution: FileExecution,
+) {
+  execution.guard();
+  if (
+    !cache
+      .getQueryData<Attachment[]>(currentFilesKey(cache, clientId))
+      ?.some((file) => file.id === id)
+  )
+    throw new ApiError(
+      409,
+      "Refresh the client files before changing this file.",
+    );
+}
+
+export async function saveFileMetadata(
+  api: ApiClient,
+  cache: QueryClient,
+  clientId: string,
+  id: string,
+  change: FileMetadataChange,
+  execution: FileExecution,
+) {
+  currentFile(cache, clientId, id, execution);
+  const key = fileMetadataAttemptKey(clientId, id, execution.actor);
+  if (cache.getQueryData<FileMetadataAttempt | null>(key))
+    throw new ApiError(409, "Review the current file before saving again.");
+  const token = nextFileMetadataAttempt();
+  setFileMetadataAttempt(cache, key, { token, status: "pending", change });
+  let received = false;
+  try {
+    const result = await api.request(
+      "core",
+      `clients/${clientId}/files/${id}/${change.kind === "move" ? "folder" : "access"}`,
+      fileChangeForIdSchema(id, change),
+      {
+        method: "PATCH",
+        signal: execution.signal,
+        body:
+          change.kind === "move"
+            ? { folder: change.folder }
+            : {
+                viewerMode: change.viewerMode,
+                viewerUserIds: change.viewerUserIds,
+              },
+      },
+    );
+    received = true;
+    currentFile(cache, clientId, id, execution);
+    settleFileMetadataAttempt(cache, key, token, false);
+    return result;
+  } catch (error) {
+    settleFileMetadataAttempt(
+      cache,
+      key,
+      token,
+      received || execution.signal.aborted || ambiguousClientWrite(error),
+    );
+    throw error;
+  }
+}
+
+// A GET establishes current state only; it cannot prove which PATCH produced it.
+export async function reviewFileMetadata(
+  api: ApiClient,
+  cache: QueryClient,
+  clientId: string,
+  id: string,
+  execution: FileExecution,
+) {
+  currentFile(cache, clientId, id, execution);
+  const key = fileMetadataAttemptKey(clientId, id, execution.actor);
+  const attempt = cache.getQueryData<FileMetadataAttempt | null>(key);
+  if (attempt?.status !== "unknown")
+    throw new ApiError(
+      409,
+      "Wait for the file save to finish before reviewing it.",
+    );
+  const current = await api.request(
+    "core",
+    `clients/${clientId}/files/${id}/access`,
+    fileAccessForIdSchema(id),
+    { signal: execution.signal },
+  );
+  currentFile(cache, clientId, id, execution);
+  settleFileMetadataAttempt(cache, key, attempt.token, false);
+  return current;
+}
diff --git a/apps/web/src/features/portfolio/files/metadata-attempt.ts b/apps/web/src/features/portfolio/files/metadata-attempt.ts
new file mode 100644
index 0000000..2cb48f9
--- /dev/null
+++ b/apps/web/src/features/portfolio/files/metadata-attempt.ts
@@ -0,0 +1,78 @@
+"use client";
+import { useMemo, useSyncExternalStore } from "react";
+import {
+  useQueryClient,
+  type QueryClient,
+  type QueryKey,
+} from "@tanstack/react-query";
+import type { ClientWriter } from "@/shared/portfolio/auth/client-writer";
+import type { FileMetadataChange } from "./contracts";
+import { useFileReader } from "./file-reader";
+
+// Cache-local replay protection, not a durable native operation receipt.
+export type FileMetadataAttempt = {
+  token: number;
+  status: "pending" | "unknown";
+  change: FileMetadataChange;
+};
+let sequence = 0;
+export const nextFileMetadataAttempt = () => ++sequence;
+export const fileMetadataAttemptKey = (
+  clientId: string,
+  id: string,
+  actor?: ClientWriter,
+) =>
+  [
+    "file-metadata-attempt",
+    actor?.tenantId ?? "",
+    actor?.userId ?? "",
+    clientId,
+    id,
+  ] as const;
+export function setFileMetadataAttempt(
+  cache: QueryClient,
+  key: QueryKey,
+  attempt: FileMetadataAttempt | null,
+) {
+  cache.setQueryDefaults(key, { gcTime: Infinity });
+  cache.setQueryData(key, attempt);
+}
+export function settleFileMetadataAttempt(
+  cache: QueryClient,
+  key: QueryKey,
+  token: number,
+  unknown: boolean,
+) {
+  const attempt = cache.getQueryData<FileMetadataAttempt | null>(key);
+  if (attempt?.token === token)
+    setFileMetadataAttempt(
+      cache,
+      key,
+      unknown ? { ...attempt, status: "unknown" } : null,
+    );
+}
+export function useFileMetadataAttempt(clientId: string, id: string) {
+  const cache = useQueryClient();
+  const reader = useFileReader();
+  const tenantId = reader?.tenantId;
+  const userId = reader?.userId;
+  const key = useMemo(
+    () =>
+      fileMetadataAttemptKey(
+        clientId,
+        id,
+        tenantId && userId ? { tenantId, userId } : undefined,
+      ),
+    [clientId, id, tenantId, userId],
+  );
+  const encoded = JSON.stringify(key);
+  const attempt = useSyncExternalStore(
+    (notify) =>
+      cache.getQueryCache().subscribe((event) => {
+        if (JSON.stringify(event.query.queryKey) === encoded) notify();
+      }),
+    () => cache.getQueryData<FileMetadataAttempt | null>(key) ?? null,
+    () => null,
+  );
+  return { key, attempt };
+}
