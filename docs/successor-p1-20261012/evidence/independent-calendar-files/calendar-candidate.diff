diff --git a/apps/web/src/features/portfolio/calendar/artifacts/api.ts b/apps/web/src/features/portfolio/calendar/artifacts/api.ts
new file mode 100644
index 0000000..32734e3
--- /dev/null
+++ b/apps/web/src/features/portfolio/calendar/artifacts/api.ts
@@ -0,0 +1,102 @@
+import { ApiError, type ApiClient } from "@/shared/portfolio/api/http";
+import { meetingSchema } from "../contracts";
+import {
+  artifactReceiptSchema,
+  type ArtifactActor,
+  type ArtifactChange,
+  type ArtifactKind,
+  type ArtifactMeeting,
+} from "./contracts";
+
+export class ArtifactMutationError extends Error {
+  constructor(
+    message: string,
+    public readonly uncertain: boolean,
+  ) {
+    super(message);
+    this.name = "ArtifactMutationError";
+  }
+}
+
+function operation(base: string, kind: ArtifactKind, change: ArtifactChange) {
+  if (change.action === "save")
+    return {
+      path: `${base}/${kind}${change.id ? `/${encodeURIComponent(change.id)}` : ""}`,
+      method: change.id ? "PATCH" : "POST",
+      body: { body: change.body, confidential: change.confidential },
+    };
+  if (change.action === "approve")
+    return {
+      path: `${base}/${kind}/${encodeURIComponent(change.id)}/approve`,
+      method: "POST",
+      body: undefined,
+    };
+  return {
+    path: `${base}/artifacts/${change.action}`,
+    method: "POST",
+    body: {
+      artifacts: [
+        { type: kind === "notes" ? "note" : "debrief", id: change.id },
+      ],
+    },
+  };
+}
+
+export async function changeMeetingArtifact(
+  api: ApiClient,
+  meeting: ArtifactMeeting,
+  kind: ArtifactKind,
+  actor: ArtifactActor,
+  change: ArtifactChange,
+  assertCurrent: () => void,
+  signal: AbortSignal,
+) {
+  let dispatched = false;
+  let knownRefusal = false;
+  const base = `engagement/meetings/${encodeURIComponent(meeting.id)}`;
+  try {
+    assertCurrent();
+    await api.request(
+      "core",
+      base,
+      meetingSchema.refine(
+        (row) =>
+          row.id === meeting.id &&
+          (row.client?.id ?? null) === (meeting.client?.id ?? null),
+        "The meeting or client association changed. Reopen the meeting.",
+      ),
+      { signal },
+    );
+    assertCurrent();
+    const request = operation(base, kind, change);
+    dispatched = true;
+    await api
+      .request(
+        "core",
+        request.path,
+        artifactReceiptSchema(meeting, kind, actor, change),
+        {
+          method: request.method,
+          body: request.body,
+          signal,
+        },
+      )
+      .catch((error: unknown) => {
+        knownRefusal =
+          error instanceof ApiError &&
+          [400, 401, 403, 404, 409, 422].includes(error.status);
+        throw error;
+      });
+    assertCurrent();
+  } catch (error) {
+    const uncertain = dispatched && !knownRefusal;
+    throw new ArtifactMutationError(
+      uncertain
+        ? `This action may have completed.${change.action === "save" ? " Your draft is retained." : ""} Refresh the saved records and verify the result before further changes; this attempt cannot be retried here.`
+        : error instanceof Error
+          ? error.message
+          : "The artifact could not be changed.",
+      uncertain,
+    );
+  }
+}
diff --git a/apps/web/src/features/portfolio/calendar/artifacts/contracts.ts b/apps/web/src/features/portfolio/calendar/artifacts/contracts.ts
new file mode 100644
index 0000000..412711c
--- /dev/null
+++ b/apps/web/src/features/portfolio/calendar/artifacts/contracts.ts
@@ -0,0 +1,83 @@
+import { z } from "zod";
+import { meetingSchema, type Meeting } from "../contracts";
+
+export type ArtifactKind = "notes" | "debriefs";
+export type ArtifactChange =
+  | { action: "save"; id?: string; body: string; confidential: boolean }
+  | { action: "approve" | "share" | "unshare"; id: string };
+export type ArtifactActor = { userId: string; tenantId: string };
+export type ArtifactMeeting = Pick<Meeting, "id" | "client">;
+
+// Native save/approve responses contain metadata, never the saved plaintext.
+const metadataSchema = z.object({
+  id: z.string().min(1),
+  meetingId: z.string().min(1),
+  clientId: z.string().nullable(),
+  authorUserId: z.string().nullable(),
+  confidential: z.boolean(),
+  status: z.string(),
+  sharedAt: z.iso.datetime().nullable(),
+  sharedByUserId: z.string().nullable(),
+  createdAt: z.iso.datetime(),
+  updatedAt: z.iso.datetime(),
+  approvedAt: z.iso.datetime().nullable().optional(),
+  approvedByUserId: z.string().nullable().optional(),
+});
+
+export function artifactReceiptSchema(
+  meeting: ArtifactMeeting,
+  kind: ArtifactKind,
+  actor: ArtifactActor,
+  change: ArtifactChange,
+): z.ZodType {
+  const selected = metadataSchema.refine(
+    (row) =>
+      row.meetingId === meeting.id &&
+      row.clientId === (meeting.client?.id ?? null) &&
+      (!change.id || row.id === change.id),
+    "The artifact receipt does not match this meeting, client and artifact.",
+  );
+  if (change.action === "save")
+    return selected.refine(
+      (row) =>
+        row.confidential === change.confidential &&
+        row.status === (change.id ? "edited" : "draft") &&
+        (Boolean(change.id) || row.authorUserId === actor.userId) &&
+        row.sharedAt === null &&
+        row.sharedByUserId === null,
+      "The receipt does not confirm the submitted save.",
+    );
+  if (change.action === "approve")
+    return selected.refine(
+      (row) =>
+        row.status === "approved" &&
+        (kind === "debriefs" ||
+          (Boolean(row.approvedAt) && row.approvedByUserId === actor.userId)),
+      "The receipt does not confirm this approval.",
+    );
+  // Share/unshare return a decorated meeting. Other artifacts may remain shared,
+  // and an idempotent share preserves the original sharer's attribution.
+  return meetingSchema
+    .and(z.object({ [kind]: z.array(metadataSchema) }))
+    .refine((row) => {
+      const entries = row[kind] as z.infer<typeof metadataSchema>[];
+      const matches = entries.filter((item) => item.id === change.id);
+      const artifact = matches[0];
+      return (
+        row.id === meeting.id &&
+        (row.client?.id ?? null) === (meeting.client?.id ?? null) &&
+        matches.length === 1 &&
+        artifact !== undefined &&
+        selected.safeParse(artifact).success &&
+        (change.action === "share"
+          ? Boolean(
+              artifact.status === "approved" &&
+              !artifact.confidential &&
+              artifact.sharedAt &&
+              artifact.sharedByUserId &&
+              row.visibility === "shared",
+            )
+          : artifact.sharedAt === null && artifact.sharedByUserId === null)
+      );
+    }, "The meeting receipt does not confirm the selected artifact's sharing state.");
+}
diff --git a/apps/web/src/features/portfolio/calendar/artifacts/useArtifactMutation.ts b/apps/web/src/features/portfolio/calendar/artifacts/useArtifactMutation.ts
new file mode 100644
index 0000000..5eca32b
--- /dev/null
+++ b/apps/web/src/features/portfolio/calendar/artifacts/useArtifactMutation.ts
@@ -0,0 +1,104 @@
+"use client";
+import { useLayoutEffect, useRef } from "react";
+import { useQuery, useQueryClient } from "@tanstack/react-query";
+import { useApi } from "@/shared/portfolio/api/provider";
+import { useDispatchGuard } from "../access/public";
+import { ArtifactMutationError, changeMeetingArtifact } from "./api";
+import type {
+  ArtifactActor,
+  ArtifactChange,
+  ArtifactKind,
+  ArtifactMeeting,
+} from "./contracts";
+
+type Attempt = {
+  status: "idle" | "pending" | "uncertain" | "refused";
+  change?: ArtifactChange;
+  error?: Error;
+};
+const idle: Attempt = { status: "idle" };
+
+/** A session-scoped fence survives tab unmounts; it is never an idempotency claim. */
+export function useArtifactMutation(
+  meeting: ArtifactMeeting,
+  kind: ArtifactKind,
+  actor: ArtifactActor,
+) {
+  const api = useApi();
+  const cache = useQueryClient();
+  const guard = useDispatchGuard(actor.userId, actor.tenantId);
+  const key = [
+    "meeting-artifact-attempt",
+    actor.tenantId,
+    actor.userId,
+    meeting.id,
+    meeting.client?.id ?? null,
+    kind,
+  ];
+  const attempt = useQuery<Attempt>({
+    queryKey: key,
+    queryFn: () => idle,
+    enabled: false,
+    initialData: idle,
+    gcTime: Infinity,
+  }).data;
+  const lifetime = useRef<AbortController | null>(null);
+  useLayoutEffect(() => {
+    const controller = new AbortController();
+    lifetime.current = controller;
+    return () => controller.abort();
+  }, [actor.userId, actor.tenantId, meeting.id, meeting.client?.id, kind]);
+
+  const mutate = (change: ArtifactChange, onSaved: () => void) => {
+    const previous = cache.getQueryData<Attempt>(key);
+    if (previous?.status === "pending" || previous?.status === "uncertain")
+      return;
+    const controller = lifetime.current;
+    if (!controller || controller.signal.aborted) return;
+    const assertCurrent = () => {
+      controller.signal.throwIfAborted();
+      guard();
+    };
+    // setQueryData is synchronous: two submit events in the same render cannot
+    // dispatch two non-idempotent creates.
+    cache.setQueryData<Attempt>(key, { status: "pending", change });
+    void changeMeetingArtifact(
+      api,
+      meeting,
+      kind,
+      actor,
+      change,
+      assertCurrent,
+      controller.signal,
+    ).then(
+      () => {
+        cache.setQueryData<Attempt>(key, idle);
+        void cache.invalidateQueries({ queryKey: ["meeting", meeting.id] });
+        void cache.invalidateQueries({ queryKey: ["calendar", "meetings"] });
+        onSaved();
+      },
+      (error: unknown) => {
+        // Never repopulate a cleared session cache after expiration.
+        if (!cache.getQueryData<Attempt>(key)) return;
+        cache.setQueryData<Attempt>(key, {
+          status:
+            error instanceof ArtifactMutationError && error.uncertain
+              ? "uncertain"
+              : "refused",
+          change,
+          error:
+            error instanceof Error
+              ? error
+              : new Error("The artifact could not be changed."),
+        });
+      },
+    );
+  };
+  return {
+    mutate,
+    attempt,
+    isPending: attempt.status === "pending",
+    uncertain: attempt.status === "uncertain",
+    error: attempt.error,
+  };
+}
