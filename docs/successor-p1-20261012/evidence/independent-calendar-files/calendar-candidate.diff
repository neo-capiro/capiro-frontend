+    await content.press("End");
+    await content.pressSequentially(" later draft");
+    await expect(content).toHaveValue("Retain this synthetic draft");
+    await expect(
+      page.getByRole("checkbox", { name: "Confidential", exact: true }),
+    ).toBeDisabled();
+    pending.release();
