new file mode 100644
index 0000000..6f110d5
--- /dev/null
+++ b/apps/web/src/features/portfolio/relationships/email/mail-body-html.ts
@@ -0,0 +1,12 @@
+import DOMPurify from "dompurify";
+
+/** Local display/editor subset. The backend remains the send sanitizer. */
+export function safeMailBodyHtml(html: string) {
+  if (!DOMPurify.isSupported) return "";
+  return DOMPurify.sanitize(html, {
+    ALLOWED_TAGS: ["p", "br", "strong", "b", "em", "i", "u", "ul", "li"],
+    ALLOWED_ATTR: [],
+    ALLOW_DATA_ATTR: false,
+    ALLOW_ARIA_ATTR: false,
+  });
+}
diff --git a/apps/web/src/features/portfolio/relationships/email/mail-body.ts b/apps/web/src/features/portfolio/relationships/email/mail-body.ts
new file mode 100644
index 0000000..b06fd2f
--- /dev/null
+++ b/apps/web/src/features/portfolio/relationships/email/mail-body.ts
@@ -0,0 +1,27 @@
+/** Both representations belong to the same local editor revision. */
+export interface MailBody {
+  text: string;
+  html: string;
+}
+
+export function plainMailHtml(text: string) {
+  return text
+    .split(/\r?\n/)
+    .map(
+      (line) =>
+        `<p>${line.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;").replaceAll("'", "&#39;") || "<br>"}</p>`,
+    )
+    .join("");
+}
+
+export function plainMailBody(text: string): MailBody {
+  return { text, html: plainMailHtml(text) };
+}
+
+export function mailBodyError(body: MailBody) {
+  if (!body.text.trim()) return "Enter a message.";
+  if (body.text.length > 8000) return "Keep the message to 8,000 characters.";
+  if (body.html.length > 40000)
+    return "The formatted message is too large. Remove some formatting or shorten it.";
+  return "";
+}
