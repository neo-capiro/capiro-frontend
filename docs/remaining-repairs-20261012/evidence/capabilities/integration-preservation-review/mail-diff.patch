+    const reviewed = await review(page);
+    await expect(
+      reviewed.getByRole("region", { name: "Message preview" }).locator(tag),
+    ).toHaveText("Original rich draft.");
+    expect(state.sends).toHaveLength(0);
+    await reviewed
+      .getByRole("button", { name: "Send email", exact: true })
+      .click();
