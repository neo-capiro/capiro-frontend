      "reviewStatus": "reviewed",
      "blocking": false,
      "review": {
        "reason": "This controller owns one source-bound rewrite attempt and the exact body revision it may replace. Draft edits, context changes, identity-cache invalidation and unmount all revoke that same attempt; a local AbortController and post-response guard prevent stale application even if transport still completes. It reuses the existing captured mail authority rather than duplicating actor policy, and native request/schema plus HTML conversion live in rewrite.ts. The110-line body is one coupled attempt lifecycle; splitting each phase into separate hooks would obscure its shared identity and old/new attempt ordering. It does not claim server model cancellation.",
        "reviewedBy": "Codex portfolio_calendar_relationships and portfolio_objectives (independent source review)",
        "reviewedOn": "2026-10-11"
      }
    },
