# Use the designated Clerk application. Keep values in the approved secret store.
# Optional entry for the isolated Portfolio preview; unset retains the shared app home.
CAPIRO_DEFAULT_PRODUCT=portfolio
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Full service base URLs, including their existing routing prefixes.
CORE_API_BASE_URL=
STRATEGY_API_BASE_URL=
WORKSPACE_API_BASE_URL=
INTELLIGENCE_API_BASE_URL=
# Explicit tracker data owner for the designated tenant: core or intelligence.
# core uses CORE_API_BASE_URL + /intelligence; intelligence uses INTELLIGENCE_API_BASE_URL.
TRACKER_BACKEND=intelligence
MERI_API_BASE_URL=
# Existing destination frontend URLs (no second editor or Meri implementation).
CAPIRO_MERI_URL=
CAPIRO_MODULES_URL=
CAPIRO_WORKSPACE_URL=
# Origin/path root of the existing application, used for verified deep links.
CAPIRO_EXISTING_APP_URL=
